{
  "name": "play-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite --host 0.0.0.0\" \"node --env-file=.env server/index.js\"",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "node --env-file=.env server/index.js",
    "share": "pnpm build && node --env-file=.env server/index.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
